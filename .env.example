# gta6-emulation-watcher settings -- TEMPLATE, all read from the environment.
# Never put real values in a committed file. On the home-server the SMTP/MAIL values
# live in /etc/home-server/gta6-watcher.env (root 600), loaded by hs-gta6-watch.service.

# --- behaviour (optional) ---
# Model for both the per-port search agent and the review agent.
GTA6_WATCH_MODEL=claude-sonnet-5-5
# Path to the claude CLI (default: `claude` on PATH, which systemd must include).
GTA6_WATCH_CLAUDE_BIN=claude
# Seconds allowed per claude call.
GTA6_WATCH_CLAUDE_TIMEOUT=600
# State + last-run outputs (default: <repo>/data, gitignored).
GTA6_WATCH_DATA_DIR=
# 1 = still email on a day with no new findings (default: skip the email).
GTA6_WATCH_ALWAYS_EMAIL=0

# --- sources (optional) ---
# PortWatch VI tracker (JSON, refreshed ~every 3h by the site's scout).
GTA6_WATCH_PORTWATCH_URL=https://portwatch-vi.xyz/data/tracker.json
# How many of the top-ranked ports to research and report on.
GTA6_WATCH_TOP_N=5
# GitHub REST API base for the per-port repo lookup.
GTA6_WATCH_GITHUB_API=https://api.github.com
# Optional GitHub token to raise the API rate limit (60 req/hr anonymous is enough
# for 5 ports). Leave empty for anonymous access.
GTA6_WATCH_GITHUB_TOKEN=
# Seconds allowed per HTTP fetch (tracker + GitHub).
GTA6_WATCH_FETCH_TIMEOUT=30

# --- claude plan usage (optional) ---
# The digest reports the 5-hour and weekly plan-usage percentages before and after
# the run. These come from Claude's OAuth usage endpoint, read with the CLI's own
# credential. Leave unset to use the defaults; on any failure the footer shows "n/a".
# Path to the claude CLI credentials (holds the OAuth token).
GTA6_WATCH_CLAUDE_CREDS=~/.claude/.credentials.json
# Usage endpoint.
GTA6_WATCH_CLAUDE_USAGE_URL=https://api.anthropic.com/api/oauth/usage

# --- email (secrets; email is OFF unless all four of USER/PASS/FROM/TO are set) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# Gmail App Password (https://myaccount.google.com/apppasswords), not the account password.
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM=you@example.com
MAIL_TO=you@example.com
